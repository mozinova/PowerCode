{
  "name": "powercode",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:exthost": "esbuild ext-host/src/host.ts --bundle --platform=node --target=node20 --format=cjs --outfile=src-tauri/resources/ext-host.cjs",
    "check:exthost": "tsc -p ext-host",
    "prepare:exthost": "node scripts/fetch-node.mjs && bun run build:exthost",
    "gen:vscode-surface": "node scripts/gen-vscode-surface.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "@vscode/codicons": "0.0.36",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.18",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^1.75.0",
    "marked": "^18.2.1",
    "monaco-editor": "^0.57.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.24.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/vscode": "^1.146.0",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vscode-uri": "^3.2.0"
  }
}
